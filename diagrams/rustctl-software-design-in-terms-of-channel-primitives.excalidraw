    {
      "id": "qaCzwk_hHIuhT-BG4Ko3_",
      "type": "text",
      "x": 3215.587026861007,
      "y": 981.0792183186345,
      "width": 613.9791048209509,
      "height": 370.7984686858386,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "#e3fafc",
      "fillStyle": "solid",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "vzmd_ZeYhdhLN4WAaAraX",
        "2bvUhp90LT4pHgEonUybl",
        "TDozQkpZDuqsG18D1J4v1"
      ],
      "frameId": null,
      "index": "b77",
      "roundness": null,
      "seed": 1070319875,
      "version": 2708,
      "versionNonce": 1716592803,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1755351850302,
      "link": null,
      "locked": false,
      "text": "Terminator has a global shutdown signal. All actors\nare connected to the terminator such that they only\nperform their jobs until the global shutdown signal\nis activated. When the signal is activated, the\nactors are expected to finish their jobs gracefully.\n\nEach actor is also connected to the terminator such\nthat they can activate the global shutdown signal.\nIntent is that the whole program's graceful shutdown\ncan be initiated by any of the essential actors in\ncase a non-recoverable error occurs.\n\nTerminator also listens for the standard OS level\ntermination signals (SIGINT, SIGTERM).",
      "fontSize": 21.188483924905064,
      "fontFamily": 8,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Terminator has a global shutdown signal. All actors are connected to the terminator such that they only perform their jobs until the global shutdown signal is activated. When the signal is activated, the actors are expected to finish their jobs gracefully.\n\nEach actor is also connected to the terminator such that they can activate the global shutdown signal. Intent is that the whole program's graceful shutdown can be initiated by any of the essential actors in case a non-recoverable error occurs.\n\nTerminator also listens for the standard OS level termination signals (SIGINT, SIGTERM).",
      "autoResize": false,
      "lineHeight": 1.25
    },
